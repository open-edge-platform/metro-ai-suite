# Copy to .env.local for `npm run dev` (Vite dev proxy). Never commit .env.local.
# Upstreams (read by vite.config.ts only; not exposed to the browser bundle)
HERMES_BASE_URL=http://127.0.0.1:8642
HERMES_API_KEY=
VSS_BASE_URL=http://127.0.0.1:12345
# Set to true to use scripted mock adapters instead of Hermes/VSS
VITE_USE_MOCKS=false
