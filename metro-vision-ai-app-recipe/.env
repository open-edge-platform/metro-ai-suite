# This file is used to set environment variables for the Metro Vision AI App Recipe application.


# HOST_IP and SAMPLE_APP should not be manually edited.
# Instead, use the install.sh <APP_NAME> script to set these values automatically.
# HOST_IP is setup automatically from the system.
# To manually setup this IP address, run:
# install.sh <APP_NAME> [ss] [HOST_IP] e.g. $ install.sh smart-parking 10.10.10.10
# or for the SceneScape variant of smart-parking: $ install.sh smart-parking ss 10.10.10.10
# This is  the IP address of the host machine where the application will run.
HOST_IP=0.0.0.0

# DL Streamer Pipeline Server
DLSTREAMER_PIPELINE_SERVER_IMAGE=intel/dlstreamer-pipeline-server:2026.3.0-ubuntu24-rc1

# This variable identifies the name of the application to be used.
# It should match the name of the application directory in the metro-ai-suite.
# Supported applications: "smart-parking", "loitering-detection", "smart-intersection", "smart-tolling"
SAMPLE_APP=

# Open Telemetry related config
ENABLE_OPEN_TELEMETRY=true
OTEL_COLLECTOR_HOST=otel-collector
OTEL_COLLECTOR_PORT=4318
OTEL_EXPORT_INTERVAL_MILLIS=5000

# Maximum allowed size for client request body (e.g. Scenescape GLB 3D base map file uploads; max 132m)
NGINX_CLIENT_MAX_BODY_SIZE=132m

# Webrtc related config
MTX_WEBRTCICESERVERS2_0_USERNAME=myusername
MTX_WEBRTCICESERVERS2_0_PASSWORD=mypassword

#trsuted-compute network
TC_SUBNET=172.20.0.0/16
TC_DNS_IP=172.20.0.200
TC_SI_TARGET_DEVICE=CPU
TC_GPU_VFIO_GROUP=1
TC_NPU_VFIO_GROUP=2

# loitering-detection: MQTT topic/threshold config for the mqtt-table-flattener sidecar.
# Only consumed by the loitering-detection app's docker-compose deployment; unused by
# smart-parking and smart-intersection, so it has no effect on those deployments.
SOURCE_TOPIC_PREFIX=object_tracking
DEST_TOPIC_SUFFIX=loiterstatus
LOITERING_THRESHOLD_SEC=5.0

# loitering-detection: video files are looped into rtsp://rtsp-server:8554/cam-<N>.
# Set by install.sh (false for the Console UI install, which does not start the RTSP services
# and reads the video files directly); sample_start.sh uses it to pick the source.
RTSP_SOURCES=true
# Codec args for the ffmpeg feeders. With "-c copy" Stream Manager did not accept 3 of the 4
# sample videos (keyframes ~8 s apart), so they are re-encoded with a keyframe every 30 frames
# and no B-frames. Change only if your own videos work with Stream Manager as they are.
RTSP_FEEDER_CODEC_ARGS="-c:v libx264 -preset veryfast -tune zerolatency -g 30 -bf 0 -pix_fmt yuv420p"

# loitering-detection-sm (Stream Manager overlay): clip recording of loitering events.
# Only used by "./install.sh loitering-detection-sm".
STREAM_MANAGER_IMAGE=intel/stream-manager:latest
STREAM_MANAGER_SHM_SIZE=1g
# Stream numbers of the sample pipelines (object_tracking/<N>), mapped to RTSP path cam-<N>
CAMERA_IDS=1,2,3,4
# Seconds of rolling stream history kept by Stream Manager (5-300); must be >= PRE_EVENT_SEC
SM_BUFFER_LENGTH=30
# Seconds of footage kept before the loitering threshold is crossed
PRE_EVENT_SEC=5
# Seconds without any loiterer on a camera before its recording is stopped
STOP_GRACE_SEC=3
# Split a recording after this many seconds if people are still loitering (0 = no limit)
MAX_SESSION_SEC=300
# Delete the recording from Stream Manager once the clip is saved under loitering-detection/clips
DELETE_REMOTE_AFTER_DOWNLOAD=true
