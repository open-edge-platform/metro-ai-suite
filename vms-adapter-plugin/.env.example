# Variables for every VMS and analytics app are listed here. Only those of the
# VMS and apps selected with ./setup.sh --vms <vms> --apps <apps> are used.

# =============================================================================
# VMS Adapter Plugin
# =============================================================================
# App Version
APP_VERSION=2026.3.0-rc1
DOCKER_REGISTRY=
# PostgreSQL
PG_USER=vms
PG_PASSWORD=changeme
PG_HOST=postgres
PG_PORT=5434
# Dashboard (UI)
UI_HTTPS_PORT=3443
# API
VMS_PLUGIN_API_KEY=


# =============================================================================
# VMS
# =============================================================================

# ---------------------------------------------------------------
# Milestone XProtect via AI Bridge  ./setup.sh --vms milestone
# ---------------------------------------------------------------

# Host running the AI Bridge containers.
AIB_HOST=<ai-bridge-ip>
# GraphQL web service port (4000 in debug mode; use the proxy port in production).
AIB_GRAPHQL_PORT=4000
AIB_APP_HOSTNAME=<vms-adapter-host>
# TLS
AIB_TLS_VERIFY=false
# Optional: path inside vms-adapter-backend container when AIB_TLS_VERIFY=true
AIB_CA_BUNDLE=

# ---------------------------------------------------------------
# Nx Witness                          ./setup.sh --vms nx
# ---------------------------------------------------------------

NX_HOST=<nx-witness-ip>
NX_USERNAME=admin
NX_PASSWORD=changeme
# TLS
NX_TLS_VERIFY=false
# Optional: path inside vms-adapter-backend container when NX_TLS_VERIFY=true
NX_CA_BUNDLE=
# Recordings
NX_RECORDINGS_PATH=/tmp/nx-recordings

# =============================================================================
# Analytics Apps
# =============================================================================

# ---------------------------------------------------------------
# Loitering Detection (DLStreamer Vision) ./setup.sh --apps ld  
# ---------------------------------------------------------------

# DL Streamer Pipeline Server
DLS_VISION_HOST=host.docker.internal
DLS_VISION_PORT=443
DLS_VISION_TLS_VERIFY=false
# Pipelines per inference device. At least one required
DLS_PIPELINE_CPU=loiter_detect_roi_cpu
DLS_PIPELINE_GPU=loiter_detect_roi_gpu
DLS_PIPELINE_NPU=
# Loitering seconds in the zone before a person counts as loitering. Sent to the 
# pipeline at run start. Keep equal to LOITERING_THRESHOLD_SEC in the loitering recipe's .env.
LOITERING_THRESHOLD_SEC=5.0
# MQTT broker of the app, as seen by VAP (for subscribing)
MQTT_HOST=host.docker.internal
MQTT_PORT=1883
# TLS for the MQTT subscriber (the broker must be independently configured with TLS)
MQTT_TLS_ENABLED=false
MQTT_CA_BUNDLE=
MQTT_CLIENT_CERT=
MQTT_CLIENT_KEY=
# Optional: path inside vms-adapter-backend container when DLS_VISION_TLS_VERIFY=true
DLS_VISION_CA_BUNDLE=

# ---------------------------------------------------------------
# Live Video Captioning                  ./setup.sh --apps lvc
# ---------------------------------------------------------------

# LVC backend (FastAPI, default port 4173)
LVC_HOST=host.docker.internal
LVC_BASE_URL=http://host.docker.internal:4173
# MediaMTX WebRTC signaling server (default port 8889)
MEDIAMTX_URL=http://host.docker.internal:8889
# MQTT broker (eclipse-mosquitto in the LVC stack, port 1883)
MQTT_BROKER_HOST=host.docker.internal
MQTT_BROKER_PORT=1883
# TLS for the MQTT subscriber (the broker must be independently configured with TLS)
MQTT_BROKER_TLS_ENABLED=false
# Path inside the vms-adapter-backend container to the CA cert for broker cert verification.
MQTT_BROKER_CA_BUNDLE=
# Paths to client cert/key for mutual TLS (leave empty for server-only TLS).
MQTT_BROKER_CLIENT_CERT=
MQTT_BROKER_CLIENT_KEY=
