#
# Copy to deploy/.env (gitignored) and fill in. Read by deploy/compose.yaml.

# Hermes API server, scheme://host:port with no path. Use the Hermes host's IP:
# inside the container, 127.0.0.1 is the container itself.
HERMES_BASE_URL=http://127.0.0.1:8642
# Hermes API key (API_SERVER_KEY on the Hermes host). nginx adds it to Hermes
# requests; it never reaches the browser. Required.
HERMES_API_KEY=

# VSS nginx gateway (serves /manager and /datastore), scheme://host:port.
VSS_BASE_URL=http://127.0.0.1:12345

# Default floorplan: deploy/floorplans/<name>.json, read at container start
# and on every page load. Ships with simple (camera_1..camera_4) and level4;
# add your own file there. An uploaded plan replaces it in that browser.
VSG_FLOORPLAN=simple

# Where the UI listens on this host. Use 127.0.0.1 to keep it local.
VSG_UI_HOST=0.0.0.0
VSG_UI_PORT=12346

# Image to run or build: ${REGISTRY}intel/vsg-ui:${TAG}. REGISTRY needs a
# trailing slash, e.g. registry.example.com/
REGISTRY=
TAG=latest
