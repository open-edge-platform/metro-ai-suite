#
# Shared VSS proxy settings, included by each allowlisted /vss/ location.
# Rendered to /etc/nginx/conf.d/vss-proxy.inc (not matched by conf.d/*.conf).
# The upstream Host stays the VSS gateway, so image URLs VSS returns point at
# an address the VSS MCP server can reach.

if ($vsg_api_blocked) {
    return 403;
}

rewrite ^/vss(/.*)$ $1 break;
proxy_pass ${VSS_BASE_URL};

proxy_http_version 1.1;
proxy_set_header Connection "";
proxy_set_header Authorization "";
proxy_set_header Origin "";
proxy_set_header Referer "";
proxy_set_header Cookie "";
proxy_hide_header Set-Cookie;
proxy_hide_header Access-Control-Allow-Origin;
proxy_hide_header Access-Control-Allow-Credentials;
proxy_hide_header X-Content-Type-Options;
proxy_hide_header X-Frame-Options;
proxy_hide_header Content-Security-Policy;
proxy_hide_header X-Powered-By;
